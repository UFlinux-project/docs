---
import BrandIcon from './BrandIcon.astro';
import DefaultFooter from '@astrojs/starlight/components/Footer.astro';
const cs = Astro.locals.starlightRoute.locale === 'cs';
const home = `https://uflinux.org/${cs ? 'cs/' : ''}`;
---
<DefaultFooter><slot /></DefaultFooter>
<div class="uf-footer">
  <div><a class="uf-brand" href={home} translate="no">UFlinux.</a><p>{cs ? 'Malý systém. Prostor pro vaše nápady.' : 'A small system. Room for your ideas.'}</p></div>
  <nav aria-label={cs ? 'Odkazy v zápatí' : 'Footer links'}>
    <a href="https://github.com/UFlinux-project/uflinux">GitHub <BrandIcon name="arrow-up-right-from-square" /></a>
    <a href="https://github.com/UFlinux-project/docs/issues">{cs ? 'Nahlásit chybu' : 'Report an issue'} <BrandIcon name="arrow-up-right-from-square" /></a>
    <a href={`${home}credits/`}>{cs ? 'Autoři a licence' : 'Artwork & licenses'}</a>
  </nav>
  <small>{cs ? '© Přispěvatelé UFlinux · Vyvíjeno otevřeně.' : '© UFlinux contributors · Built in the open.'}</small>
</div>
