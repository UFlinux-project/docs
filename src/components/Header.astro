---
import Search from '@astrojs/starlight/components/Search.astro';
import LanguageSelect from '@astrojs/starlight/components/LanguageSelect.astro';
const cs = Astro.locals.starlightRoute.locale === 'cs';
const home = `https://uflinux.org/${cs ? 'cs/' : ''}`;
---
<div class="uf-header">
  <div class="uf-global">
    <a class="uf-brand" href={home}><img src="https://uflinux.org/assets/logo.svg" width="35" height="35" alt="" /><span translate="no">UFlinux.</span></a>
    <nav aria-label={cs ? 'Hlavní navigace' : 'Main navigation'}>
      <a href={home}>{cs ? 'Přehled' : 'Overview'}</a>
      <a href={`${home}downloads/`}>{cs ? 'Ke stažení' : 'Downloads'}</a>
      <a href={`${home}guide/`}>{cs ? 'Začínáme' : 'Get started'}</a>
      <a href={cs ? '/cs/' : '/'} aria-current="true">{cs ? 'Dokumentace' : 'Documentation'}</a>
    </nav>
    <LanguageSelect />
  </div>
  <div class="uf-toolbar"><a href={cs ? '/cs/' : '/'}>{cs ? 'DOKUMENTACE' : 'DOCUMENTATION'}</a><Search /></div>
</div>
